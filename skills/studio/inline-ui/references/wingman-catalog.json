    "evaluate": {
      "type": "object",
      "properties": {
        "expression": { "type": "string", "maxLength": 4000 },
        "values": { "$ref": "#/$defs/DynamicValue" }
      },
      "required": ["expression", "values"],
      "description": "Evaluate a restricted Wingman arithmetic/collection expression using explicitly bound variables. No JavaScript, globals, or side effects.",
      "unevaluatedProperties": false
    },
    "setValue": {
      "type": "object",
      "properties": { "path": { "type": "string" }, "value": { "$ref": "#/$defs/DynamicValue" } },
      "required": ["path", "value"],
      "description": "Set a JSON Pointer to a value after a user action. Use '/' with an object to reset the data model.",
      "unevaluatedProperties": false
    },
    "copyText": {
      "type": "object",
      "properties": { "text": { "$ref": "#/$defs/DynamicString" } },
      "required": ["text"],
      "description": "Copy text to the clipboard after a user action.",
      "unevaluatedProperties": false
    }
  },
