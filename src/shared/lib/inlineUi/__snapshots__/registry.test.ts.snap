exports[`advertises only our pinned protocol version and registered catalogs 1`] = `
{
  "v1.0": {
    "supportedCatalogIds": [
      "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
      "urn:wingman:inline-ui:catalog:1",
    ],
