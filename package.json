{
  "name": "wingman",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run bundle:pyodide && npm run bundle:duckdb",
    "dev": "vp dev",
    "bundle:pyodide": "node scripts/bundle-pyodide-packages.mjs",
    "bundle:duckdb": "node scripts/bundle-duckdb-extensions.mjs",
    "mock:companion": "node scripts/mock-companion.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/gateway.test.mjs",
    "test:e2e:challenge": "node --test --test-concurrency=1 tests/e2e/gateway-challenge.test.mjs",
    "test:e2e:bedrock-soak": "node --test --test-concurrency=1 tests/e2e/bedrock-schema-soak.test.mjs",
    "test:e2e:browser": "playwright test",
    "test:compare:codex": "node tests/e2e/codex-comparison.mjs",
    "test:compare:grader": "node --test tests/e2e/file-edit-scenario.test.mjs",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:browser && npm run test:e2e:challenge",
    "test:pyodide": "node scripts/test-pyodide-bundle.mjs",
    "test:assets": "node --test scripts/test-compress-assets.mjs",
    "prebuild": "npm run bundle:pyodide && npm run bundle:duckdb",
    "build": "vp check --no-fmt --no-lint && npm run check:react-compiler && npm run check:skills && vp build && node scripts/compress-assets.mjs",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check && npm run check:react-compiler && npm run check:skills",
    "check:react-compiler": "node scripts/check-react-compiler.mjs",
    "check:skills": "node scripts/validate-skills.mjs",
    "preview": "vp preview"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
