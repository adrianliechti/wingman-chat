{
  "name": "wingman",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run bundle:pyodide && npm run bundle:duckdb",
    "dev": "vp dev",
    "bundle:pyodide": "node scripts/bundle-pyodide-packages.mjs",
    "bundle:duckdb": "node scripts/bundle-duckdb-extensions.mjs",
    "mock:companion": "node scripts/mock-companion.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/gateway.test.mjs",
    "test:e2e:classification": "node --test tests/e2e/classification.test.mjs",
    "test:e2e:challenge": "node --test --test-concurrency=1 tests/e2e/gateway-challenge.test.mjs",
    "test:e2e:bedrock-soak": "node --test --test-concurrency=1 tests/e2e/bedrock-schema-soak.test.mjs",
    "test:e2e:browser": "playwright test",
    "test:compare:codex": "node tests/e2e/codex-comparison.mjs",
    "test:compare:grader": "node --test tests/e2e/file-edit-scenario.test.mjs",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:browser && npm run test:e2e:challenge",
    "test:pyodide": "node scripts/test-pyodide-bundle.mjs",
    "test:assets": "node --test scripts/test-compress-assets.mjs",
    "prebuild": "npm run bundle:pyodide && npm run bundle:duckdb",
    "build": "vp check --no-fmt --no-lint && npm run check:react-compiler && npm run check:skills && vp build && node scripts/compress-assets.mjs",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vitest run",
    "check": "vp check && npm run check:react-compiler && npm run check:skills",
    "check:react-compiler": "node scripts/check-react-compiler.mjs",
    "check:skills": "node scripts/validate-skills.mjs && npm run check:ui-reference",
    "generate:ui-reference": "node scripts/generate-inline-ui-reference.mjs",
    "check:ui-reference": "node scripts/generate-inline-ui-reference.mjs --check",
    "preview": "vp preview"
  },
  "dependencies": {
    "@a2ui/web_core": "0.14.0",
    "@ag-ui/core": "1.0.3",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@floating-ui/react": "^0.27.20",
    "@fontsource/noto-emoji": "^5.3.2",
    "@headlessui/react": "^2.2.10",
    "@mcp-ui/client": "^7.1.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-fetch": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@tailwindcss/browser": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-client": "^1.0.0",
    "@tanstack/ai-compaction": "^1.0.0",
    "@tanstack/ai-mcp": "^1.0.0",
    "@tanstack/ai-openai": "^1.0.0",
    "@tanstack/ai-react": "^1.0.0",
    "@tanstack/ai-skills": "^1.0.0",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/pacer": "^0.23.1",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@tanstack/store": "^0.11.2",
    "@voidzero-dev/vite-plus-core": "1.3.0",
    "alpinejs": "^3.17.5",
    "apache-arrow": "21.2.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.50",
    "diff": "^9.0.0",
    "docx": "^9.13.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "emoji-regex": "^11.0.0",
    "entities": "^8.1.0",
    "gemoji": "^8.1.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "just-bash": "^3.6.0",
    "katex": "^0.19.0",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.62.1",
    "mermaid": "^12.2.0",
    "mime": "^4.1.1",
    "pdfjs-dist": "^6.4.299",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "sax": "^1.6.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zod-a2ui": "npm:zod@3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@modelcontextprotocol/server": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "chevrotain": {
      "lodash-es": "^4.18.1"
    },
    "guarded-fetch": {
      "undici": "^7.29.1"
    },
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "@mongodb-js/zstd@7.0.0": true,
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true
  }
}
