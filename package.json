    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "just-bash": "^3.4.2",
    "katex": "^0.18.9",
    "lucide": "^1.48.0",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "mediabunny": "^1.61.0",
    "mermaid": "^12.0.0",
