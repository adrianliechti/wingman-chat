    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "chevrotain": {
      "lodash-es": "^4.18.1"
    },
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "@mongodb-js/zstd@7.0.0": true,
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true
  }
