{
  "name": "wingman",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run bundle:pyodide",
    "dev": "vp dev",
    "bundle:pyodide": "node scripts/bundle-pyodide-packages.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/gateway.test.mjs",
    "test:e2e:challenge": "node --test --test-concurrency=1 tests/e2e/gateway-challenge.test.mjs",
    "test:e2e:bedrock-soak": "node --test --test-concurrency=1 tests/e2e/bedrock-schema-soak.test.mjs",
    "test:e2e:browser": "playwright test",
    "test:e2e:memory": "node --test --test-concurrency=1 tests/e2e/memory.test.mjs",
    "test:compare:codex": "node tests/e2e/codex-comparison.mjs",
    "test:compare:grader": "node --test tests/e2e/file-edit-scenario.test.mjs",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:browser && npm run test:e2e:challenge",
    "test:pyodide": "node scripts/test-pyodide-bundle.mjs",
    "prebuild": "npm run bundle:pyodide",
    "build": "vp check --no-fmt --no-lint && npm run check:skills && vp build",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check && npm run check:skills",
    "check:skills": "node scripts/validate-skills.mjs",
    "preview": "vp preview"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource/noto-emoji": "^5.3.0",
    "@headlessui/react": "^2.2.10",
