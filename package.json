    "rehype-react": "^8.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sax": "^1.6.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.0.12",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.3.0",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "$vite"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "@mongodb-js/zstd@7.0.0": true,
    "core-js@3.49.0": true,
    "fsevents@2.3.3": true
  }
}
